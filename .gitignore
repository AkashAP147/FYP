# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large uploads and outputs (Do NOT commit user photos or outputs)
static/uploads/*
!static/uploads/.gitkeep
static/outputs/*
!static/outputs/.gitkeep
static/garments/*
!static/garments/.gitkeep
static/debug_masks/*
!static/debug_masks/.gitkeep
densepose_/tmp/*
!densepose_/tmp/.gitkeep

# Temporary backups and tests
.backup_tweaks/
*.tmp
*.log

# Virtual environments
venv/
env/
ENV/
.venv/

# Large model weights (downloaded automatically on runtime)
*.pth
*.safetensors

# Colab / Jupyter checkpoints
.ipynb_checkpoints/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
